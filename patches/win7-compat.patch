--- a/vendor/cpp-httplib/httplib.h
+++ b/vendor/cpp-httplib/httplib.h
@@ -12,7 +12,10 @@
 #define CPPHTTPLIB_VERSION_NUM "0x003901"
 
 #ifdef _WIN32
-#if defined(_WIN32_WINNT) && _WIN32_WINNT < 0x0A00
+// Win7 compat patch: upstream rejects _WIN32_WINNT < 0x0A00, but this build
+// replaces the Win8+ APIs (CreateFile2 / *FromApp) with Win7-compatible ones
+// (see httplib.cpp), so older targets are intentionally allowed here.
+#if 0 && defined(_WIN32_WINNT) && _WIN32_WINNT < 0x0A00
